# Copy to .env for local testing, or set in Vercel's dashboard for deployment.
# Without this set, /api/chat still works — it falls back to returning the
# top retrieved chunk directly instead of a generated answer (see README).
GROQ_API_KEY=

# Optional. Enables semantic (meaning-based) retrieval via Hugging Face's
# hosted sentence-similarity API instead of the built-in TF-IDF fallback.
# Get a free token at https://huggingface.co/settings/tokens — create a
# FINE-GRAINED token and check "Make calls to Inference Providers"; a
# plain Read token gets a 403 on Hugging Face's current API. Without this
# set, retrieval still works — it just falls back to TF-IDF (see README).
HF_API_KEY=
